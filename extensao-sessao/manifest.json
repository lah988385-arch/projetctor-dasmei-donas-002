{
  "manifest_version": 3,
  "name": "DonasPainel — Importar PGMEI",
  "version": "3.1.0",
  "description": "Lote: dirige a página do PGMEI (preenche CNPJ + Continuar) deixando o captcha do seu navegador passar, e baixa todos os anos de cada CNPJ da lista.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.receita.fazenda.gov.br/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://www8.receita.fazenda.gov.br/SimplesNacional/Aplicacoes/ATSPO/pgmei.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DonasPainel — Importar PGMEI"
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
